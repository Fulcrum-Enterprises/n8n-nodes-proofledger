{
	"name": "n8n-nodes-proofledger",
	"version": "0.1.2",
	"description": "n8n community node for ProofLedger: anchor a file's SHA-256 hash on the Polygon blockchain, read proofs back, and start workflows when a proof is anchored. The file never leaves n8n.",
	"license": "MIT",
	"homepage": "https://proofledger.io/platforms",
	"keywords": [
		"n8n-community-node-package",
		"proofledger",
		"proof of existence",
		"timestamp",
		"sha256",
		"polygon",
		"timestamping"
	],
	"author": {
		"name": "Craig Solomon",
		"email": "support@proofledger.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fulcrum-Enterprises/n8n-nodes-proofledger.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"templates"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ProofLedgerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ProofLedger/ProofLedger.node.js",
			"dist/nodes/ProofLedgerTrigger/ProofLedgerTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "^21.0.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
